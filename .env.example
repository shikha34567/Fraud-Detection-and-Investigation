# Environment Configuration for Financial Fraud Detection System
APP_ENV=development
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=sqlite:///data/fraud_detection.db

# Model Paths
MODEL_ARTIFACTS_DIR=artifacts/models
EXPLAINER_ARTIFACTS_DIR=artifacts/explainers

# Fraud Probability Thresholds for Risk Levels (0 to 100)
RISK_THRESHOLD_LOW=20
RISK_THRESHOLD_MEDIUM=50
RISK_THRESHOLD_HIGH=75
# >= 75 is High, >= 90 is Critical

# Simulator Configuration
STREAM_DEFAULT_BATCH_SIZE=5
STREAM_DEFAULT_INTERVAL_SEC=2.0
